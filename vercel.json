{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/management-task-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/compliance-events",
      "schedule": "10 * * * *"
    },
    {
      "path": "/api/cron/daily-role-reports",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/weekly-module-reports",
      "schedule": "0 18 * * 6"
    },
    {
      "path": "/api/cron/purge-expired-r2-attachments",
      "schedule": "15 6 * * *"
    }
  ],
  "functions": {
    "api/health.js": {
      "includeFiles": "server/**",
      "maxDuration": 30
    },
    "api/auth-entry.js": {
      "includeFiles": "server/**",
      "maxDuration": 30
    },
    "api/collections-entry.js": {
      "includeFiles": "{server/**,node_modules/pdfkit/js/data/**}",
      "maxDuration": 30
    },
    "api/cron-entry.js": {
      "includeFiles": "{server/**,node_modules/pdfkit/js/data/**}",
      "maxDuration": 120
    },
    "api/uploads-entry.js": {
      "includeFiles": "server/**",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/google/:path*",
      "destination": "/api/auth-entry"
    },
    {
      "source": "/api/auth/firebase/:path*",
      "destination": "/api/auth-entry"
    },
    {
      "source": "/api/auth/email/:path*",
      "destination": "/api/auth-entry"
    },
    {
      "source": "/api/auth/token/:path*",
      "destination": "/api/auth-entry"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "/api/auth-entry"
    },
    {
      "source": "/api/collections/:path*",
      "destination": "/api/collections-entry"
    },
    {
      "source": "/api/cron/:path*",
      "destination": "/api/cron-entry"
    },
    {
      "source": "/api/uploads",
      "destination": "/api/uploads-entry"
    },
    {
      "source": "/api/uploads/:path*",
      "destination": "/api/uploads-entry"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/collections-entry"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/:path((?!api/|src/|favicon\\.svg|app-config\\.js|firebase-messaging-sw\\.js|manifest\\.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
